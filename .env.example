# Copy to .env (gitignored) to override settings on this machine only.
# Defaults live in backend/app/config/settings.yml: any key there can be set here in upper case.

# Secret, only needed when LLM_PROVIDER=openrouter. Never put it in settings.yml.
OPENROUTER_API_KEY=

# Examples of overrides:
# LLM_PROVIDER=openrouter
# OLLAMA_MODEL=qwen3:14b
# JUDGE_MIN_LEVEL=4
# LOG_LEVEL=DEBUG

# Desktop client: read from the environment (not from this file), overrides desktop/config/settings.yml.
# BOCARE_API_URL=http://127.0.0.1:8000
